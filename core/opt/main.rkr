enum opt<T> {
    None,
    Some(T),
}

impl <T> opt<T> {
    fun unwrap(self): T {
        match self {
            opt::None => {
                panic::panic("opt::unwrap called on opt::None");
            }
            opt::Some(value) => {
                return value;
            }
        }
    }

    fun as_ref(&self): opt<&T> {
        match self {
            opt::None => {
                return opt::None;
            }
            opt::Some(value) => {
                return opt::Some(value);
            }
        }
    }

    fun get_mut(&mut self): opt<&mut T> {
        match self {
            opt::None => {
                return opt::None;
            }
            opt::Some(mut_ref) => {
                return opt::Some(mut_ref);
            }
        }
    }
}
