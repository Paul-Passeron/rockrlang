struct str {
    data: *char;
    len: int;
}

impl str {
    fun from_cstr(data: *char): Self {
        let mut len: int = 0;
        while data[len] != 0 {
            len = len + 1;
        }
        return str {
            .data: data,
            .len: len
        };
    }

    fun as_ptr(&self): *char {
        return self.data;
    }

    fun len(&self): int {
        return self.len;
    }

    fun println(&self): void {
        printf(c"%.*s\n", self.len, self.data);
    }

    fun print(&self): void {
        printf(c"%.*s", self.len, self.data);
    }
}

@extern {
    @[ffi(C, printf)]
    fun printf(fmt: *char, +): void;
}
