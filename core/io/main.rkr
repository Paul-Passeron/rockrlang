struct str {
    data: *char;
    len: usize;
}

impl str {
    @[inline]
    fun from_cstr(data: *char): void {
        let len: usize = 0;
        while data[len] != 0 {
            len = len + 1;
        }
        return str {
            .data: data,
            .len: len
        };
    }

    @[inline]
    fun as_ptr(&self): *char {
        return self$.data;
    }

    @[inline]
    fun len(&self): usize {
        return self$.len;
    }

    @[inline]
    fun println(&self): void {
        printf("%s\n", self.data);
    }

    @[inline]
    fun print(&self): void {
        printf("%s", self.data);
    }
}

@extern {
    @[ffi(C, printf)]
    fun printf(fmt: *char, +): void;
}
