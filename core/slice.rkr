@include core::opt
@include core::panic
@include core::iter

impl <T> &[T] {
    fun len(self): usize {
        let this = self;
        return @metadata(self);
    }
}

impl <T> &mut [T] {
    fun len(self): usize {
        let this = self;
        return @metadata(self);
    }
}

struct SliceIter<T> {
    slice: &[T];
    idx: usize;
}

impl <T> Iter for SliceIter<T> {
    type Item = &T;

    fun next(&mut self): opt<&T> {
        if self.slice.len() > self.idx {
            let res = &self.slice[self.idx];
            self.idx = self.idx + 1;
            return opt::Some(res);
        } else {
            return opt::None;
        }
    }
}

impl <T> IntoIterator for &[T] {
    type Out = SliceIter<T>;
    fun into_iter(self): SliceIter<T> {
        return SliceIter {
            .slice: self,
            .idx: 0,
        };
    }
}
