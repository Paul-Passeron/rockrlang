@include core::opt
@include core::panic

impl <T> [T] {
    fun len(&self): usize {
        let this = self;
        return @metadata(self);
    }
}

struct SliceIter<T> {
    slice: &[T];
    idx: usize;
}

impl <T> iter::Iter for SliceIter<T> {
    type Item = &T;
    
    fun next(&mut self): opt<&T> {
        panic("TODO");
    }
}

impl <T> iter::IntoIterator for &[T] {
    type Out = SliceIter<T>;
    fun into_iter(self): SliceIter<T> {
        return SliceIter {
            .slice: self,
            .idx: 0,
        };
    }
}
