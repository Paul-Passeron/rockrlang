@include core::iter
@include core::opt
@include core::panic

@extern {
    @[ffi(C, malloc)]
    fun malloc(size: usize): *mut void;
}
   
@extern {
    @[ffi(C, realloc)]
    fun realloc(ptr: *mut void, size: usize): *mut void;
} 

@extern {
    @[ffi(C, free)]
    fun free(ptr: *mut void): void;
}

struct Vec<T> {
    contents: *mut T;
    len: usize;
    cap: usize;
}

impl <T> core::mem::Drop for Vec<T> {
    fun drop(&mut self): void {
        self.deinit();
    }
}


impl<T> Vec<T> {
    fun new(): Self {
        return Vec {
            .contents: 0,
            .len: 0,
            .cap: 0,
        };
    }

    fun with_capacity(cap: usize): Self {
        if cap == 0 {
            return Vec::new();
        }
        return Vec {
            .contents: malloc(cap * @sizeof(T)) as *mut T,
            .len: 0,
            .cap: cap,
        };
    }

    fun grow(&mut self): void {
        let mut new_cap: usize = 0;
        if self.cap == 0 {
            new_cap = 4;
        } else { 
            new_cap = self.cap * 2;
        }
        let new_ptr = realloc(self.contents as *mut void, new_cap * @sizeof(T)) as *mut T;
        if new_ptr == 0 {
            core::panic::panic("Vec: allocation failed");
        }
        self.contents = new_ptr;
        self.cap = new_cap;
    }

    fun push(&mut self, value: T): void {
        if self.len == self.cap {
            self.grow();
        }
        self.contents[self.len] = value;
        self.len = self.len + 1;
    }

    fun pop(&mut self): opt<T> {
        if self.len == 0 {
            return opt::None;
        }
        self.len = self.len - 1;
        return opt::Some(self.contents[self.len]);
    }

    fun unsafe_idx(&self, idx: usize): *T {
        return self.contents[idx]@;
    }

    fun get(&self, idx: usize): opt<T> {
        if idx >= self.len {
            return opt::None;
        }
        let idx_ptr = self.unsafe_idx(idx);
        return opt::Some(*idx_ptr);
    }


    fun is_empty(&self): bool {
        return self.len == 0;
    }

    fun clear(&mut self): void {
        // No destructors in the language yet, so truncating is just this:
        self.len = 0;
    }

    fun deinit(&mut self): void {
        // Manual for now; becomes Drop when you have destructors.
        if self.cap != 0 {
            free(self.contents as *mut void);
            self.contents = 0;
            self.len = 0;
            self.cap = 0;
        }
    }
}

struct VecIter<T> {
    vec: Vec<T>;
    idx: usize;
}

impl<T> Iter for VecIter<T> {
    type Item = T;

    fun next(&mut self): opt<T> {
        if self.idx >= self.vec.len {
            return opt::None;
        }
        let res = self.vec.unsafe_idx(self.idx)$;
        self.idx = self.idx + 1;
        return opt::Some(res);
    }
}

impl<T> IntoIterator for Vec<T> {
    type Out = VecIter<T>;

    fun into_iter(self): VecIter<T> {
        return VecIter {
            .vec: self,
            .idx: 0,
        };
    }
}

impl <T> Vec<T> {
    fun to_array(self): Array<T> {
        let contents = realloc(self.contents as *mut void, @sizeof(T) * self.len as usize);
        return Array {
            .contents: contents as *mut T,
            .len: self.len
        };
    }
}

struct Array<T> {
    contents: *mut T;
    len: usize;
}

impl <T> Array<T> {
    fun empty(): Self {
        return Self {
            .contents: 0 as *mut _,
            .len: 0
        };
    }

    fun new(len: usize): Self {
        if len == 0 {
            return Self::empty();
        }
        let mut cap = len;
        if cap == 0 {
            cap = 1;
        }
        let contents = malloc(@sizeof(T) * cap);
        return Self {
           .contents: contents as *mut _,
           .len: cap
        };
    }

    fun get(&self, idx: usize):  opt<&T> {
        if idx < self.len {
            return opt::Some(&self.contents[idx]);
        }
        return opt::None;
    }

    fun set(&mut self, idx: usize, value: T): void {
        if idx >= self.len {
            panic("Cannot set a value beyond the array's length");
        }
        self.contents[idx] = value;
    }

    fun iter(&self): ArrayIterRef<T> {
        return ArrayIterRef {
            .arr: self,
            .idx: 0
        };
    }

    fun iter_owned(self): ArrayIter<T> {
        return ArrayIter {
            .arr: self,
            .idx: 0
        };
    }
}

struct ArrayIterRef<T> {
    arr: &Array<T>;
    idx: usize;
}

struct ArrayIter<T> {
    arr: Array<T>;
    idx: usize;
}

impl<T> Iter for ArrayIter<T> {
    type Item = T;

    fun next(&mut self): opt<T> {
        let res = self.arr.get(self.idx);
        match res {
            opt::Some(r) => {
                self.idx = self.idx + 1;
                return opt::Some(*r);
            }
            opt::None => {
                return opt::None;
            }
        }
    }
}

impl<T> Iter for ArrayIterRef<T> {
    type Item = &T;

    fun next(&mut self): opt<&T> {
        let res = self.arr.get(self.idx);
        match res {
            opt::Some(_) => {self.idx = self.idx + 1;} 
            _ => {}
        }
        return res;
    }
}

impl <T> IntoIterator for Array<T> {
    type Out = ArrayIter<T>;

    fun into_iter(self): ArrayIter<T> {
        return self.iter_owned();
    }
}

impl <T> IntoIterator for &Array<T> {
    type Out = ArrayIterRef<T>;

    fun into_iter(self): ArrayIterRef<T> {
        return self.iter();
    }
}

impl <T> core::mem::Drop for Array<T> {
    fun drop(&mut self): void {
        free(self.contents as *mut _);
    }
}
