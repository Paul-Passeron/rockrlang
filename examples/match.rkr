enum Foo {
    bar,
    baz(int),
    qux { x: *Foo; y: str },
    quux(int, int, int),
}

fun foo(f: Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {
            let a: int = x;
        }
        Foo::qux { x, y } => {
            let a: *Foo = x;
            let b: str = y;
        }
        Foo::quux(a, b, c) => {
            let x: int = a;
            let y: int = b;
            let z: int = c;
        }
    }
}

fun bar(f: Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {
            let a: int = x;
        }
        Foo::qux { x: z, y } => {
            let a: *Foo = z;
            let b: str = y;
        }
        Foo::quux(a, b, c) => {
            let x: int = a;
            let y: int = b;
            let z: int = c;
        }
    }
}


fun ref_foo(f: &Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {
            let a: &int = x;
        }
        Foo::qux { x, y } => {
            let a: &*Foo = x;
            let b: &str = y;
        }
        Foo::quux(a, b, c) => {
            let x: &int = a;
            let y: &int = b;
            let z: &int = c;
        }
    }
}

fun ref_bar(f: &Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {
            let a: &int = x;
        }
        Foo::qux { x: z, y } => {
            let a: &*Foo = z;
            let b: &str = y;
        }
        Foo::quux(a, b, c) => {
            let x: &int = a;
            let y: &int = b;
            let z: &int = c;
        }
    }
}

fun unannotated(f: &Foo): void {
    match f {
        Foo::qux { x, y } => { let a = x; }
        _ => {}
    }
}
