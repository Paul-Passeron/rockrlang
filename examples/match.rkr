enum Foo {
    bar,
    baz(int),
    qux { x: *Foo, y: str },
    quux(int, int, int),
}

fun foo(f: Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {}
        Foo::qux { x } => {}
        Foo::quux(a, b, x) => {}
    }
}

fun bar(f: Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {}
        Foo::qux { x: y } => {}
        Foo::quux(a, b, x) => {}
    }
}


fun ref_foo(f: &Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {}
        Foo::qux { x } => {}
        Foo::quux(a, b, x) => {}
    }
}

fun ref_bar(f: &Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {}
        Foo::qux { x: y } => {}
        Foo::quux(a, b, x) => {}
    }
}
