enum Foo {
    bar,
    baz(int),
    qux { x: *Foo; y: str },
    quux(int, int, int),
}

fun foo(f: Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {
            let a: int = x;
        }
        Foo::qux { x, y } => {
            let a: *Foo = x;
            let b: str = y;
        }
        Foo::quux(a, b, x) => {}
    }
}

fun bar(f: Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {}
        Foo::qux { x: z, y } => {}
        Foo::quux(a, b, x) => {}
    }
}


fun ref_foo(f: &Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {}
        Foo::qux { x, y } => {}
        Foo::quux(a, b, x) => {}
    }
}

fun ref_bar(f: &Foo): void {
    match f {
        Foo::bar => {}
        Foo::baz(x) => {}
        Foo::qux { x: z,  y } => {}
        Foo::quux(a, b, x) => {}
    }
}
