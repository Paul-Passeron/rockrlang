@include core::iter
@include core::opt
@include core::panic

interface Display {
    fun display(&self): void;
}

impl Display for int {
    fun display(&self): void {
        core::io::printf(c"%d", *self);
    }
}

impl Display for str {
    fun display(&self): void {
        self.print();
    }
}

fun print_slice<T: Display>(slice: &[T]): void {
    for x in slice {
        x.display();
        core::io::printf(c" ");
    }
}

fun print_slices<T: Display>(slices: &[&[T]]): void {
    for slice in slices {
        print_slice(*slice);
        core::io::printf(c"\n");
    }
}

fun main(): int {
    let s: &[int] = &{1, 2, 4, 10000} as _;
    let s2: &[int] = &{111, 222, 333, 444} as _;
    let slices: &[&[int]] = &{s, s2, s} as _;
    let str_slice_0: &[str] = &{"hello", "world"} as _;
    let str_slice_1: &[str] = &{"How", "are", "you", "?"} as _;
    let string_slices: &[&[str]] = &{str_slice_0, str_slice_1} as _;
    print_slices(slices);
    print_slices(string_slices);
    return 0;
}
