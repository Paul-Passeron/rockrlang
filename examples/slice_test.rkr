@include core::iter
@include core::opt
@include core::panic

fun foo(xs: &[int]): void {
    let x = xs.len();
    for i in 0..x as int {
        let j = xs[i];
    }
}

fun bar(xs: &[int]): void {
    for x in xs {
        let y = x;
    }
}

fun my_slices(slices: &[&[int]]): void {
    for outer in slices {
        for inner in *outer {
            let x = inner;
        }
    }
}
