@include core::iter
@include core::opt
@include core::panic

fun foo(xs: &[int]): void {
    let x = xs.len();
    for i in 0..x as int {
        let j = xs[i];
        core::io::printf(c"i=%d, j=%d\n", i, j);
    }
}

fun my_slices(slices: &[&[int]]): void {
    for i in 0..slices.len() as int {
        foo(slices[i]);
    }
}

fun main(): int {
    let s: &[int] = &{1, 2, 4, 10000} as _;
    let slices: &[&[int]] = &{s, s, s, s, s, s} as _;
    my_slices(slices);
    return 0;
}
