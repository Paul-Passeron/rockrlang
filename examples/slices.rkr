@include core::vec

fun main(): int {
    let x: [int] = { 1, 2, 3, 4, 5 };   // Creating a slice (array with length)
    let y = x[1..3];                    // Creating a sub-slice (contains elements at indices 1 and 2)
    let known_slice: [int; 2] = y;      // Fine
    let unknown_slice: [int] = y;       // Fine as well
    let bad_slice: [int; 150] = y;      // Error (or warning): slice length mismatch
    let v: Vec<str> = Vec<str>::from_slice({"hello", "world"});
    return 0;
}
