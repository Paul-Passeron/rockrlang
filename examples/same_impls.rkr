interface A {}
interface B {}
interface C {}

struct a<T> {}

impl <T: A + B + C> a<T> {} // Should all have the same Impl Id
impl <T: B + A + C> a<T> {} // Should all have the same Impl Id
impl <T: B + C + A> a<T> {} // Should all have the same Impl Id

impl <T: B + B> a<T> {}     // Those two as well
impl <T: B> a<T> {}         // Those two as well
