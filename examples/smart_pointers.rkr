@include std::mem

struct InnerRef<T> {
    data: T;
    ref_count: u64;
}

struct Ref<T> {
    inner: *InnerRef<T>;
}

impl <T> Ref<T> {
    fun new(counted: T): Ref<T> {
        let inner: *InnerRef<T> = malloc(@sizeof(InnerRef<T>));
        inner$.data = counted;
        inner$.ref_count = 1;
        return Ref { .inner:  inner };
    }

    fun count(&self): u64 {
        return self$.inner.ref_count;
    }
}

impl <T: Drop> Drop for Ref<T> {
    fun drop(self): void {
        self.inner$.ref_count -= 1;
        if self.inner$.ref_count == 0 {
            self.inner$.data.drop();
            free(self.inner);
        }
    }
}

impl <T: NoDrop> Drop for Ref<T> {
    fun drop(self): void {
        self.inner$.ref_count -= 1;
        if self.inner.ref_count == 0 {
            free(self.inner);
        }
    }
}

impl <T> Clone for Ref<T> {
    fun clone(&self): Ref<T> {
        self$.inner$.ref_count += 1;
        return Ref { .inner: self$.inner };
    }
}

impl <T> AsRef for Ref<T> {
    fun a_ref(&self): &T {
        return self$.inner.data@;
    }
}


fun main(): int {
    let x_0 = Ref<i32>::new(69);
    let x_1 = x_0.clone();
    let x_2 = x_1.clone();
    let x_3 = x_2.clone();

    printf("Count = %ld, %d, %d, %d, %d\n",
        x_0.count(),
        x_0.as_ref()$,
        x_1.as_ref()$,
        x_2.as_ref()$,
        x_3.as_ref()$);

    x_0.as_ref()$ = 420;

    printf("Count = %ld, %d, %d, %d, %d\n",
        x_0.count(),
        x_0.as_ref()$,
        x_1.as_ref()$,
        x_2.as_ref()$,
        x_3.as_ref()$);
    return 0;
}
