@include std::io

// ============================================================
// Structs (plain, nested, generic)
// ============================================================

struct Point {
    x: int;
    y: int;
}

struct Pair<A, B> {
    first: A;
    second: B;
}

struct Wrapper<T> {
    inner: T;
}

struct Node<T> {
    data: T;
    next: *Node<T>;
}

interface Printable {
    fun print(&self): void;
}

interface Container<T> {
    fun get(&self): &T;
}

impl Point {
    fun new(x: int, y: int): Point {
        return Point { .x: x, .y: y };
    }

    fun manhattan(&self): int {
        let dx = self$.x;
        let dy = self$.y;
        if dx < 0 { dx = -dx; }
        if dy < 0 { dy = -dy; }
        return dx + dy;
    }

    fun translate(&self, dx: int, dy: int): Point {
        return Point { .x: self$.x + dx, .y: self$.y + dy };
    }
}

impl Printable for Point {
    fun print(&self): void {
        printf("(%d, %d)", self$.x, self$.y);
    }
}

impl <T> Wrapper<T> {
    fun wrap(value: T): Wrapper<T> {
        return Wrapper { .inner: value };
    }

    fun unwrap(&self): T {
        return self$.inner;
    }
}


// Literals
fun test_literals(): int {
    let i: int = 42;
    let c: char = 'z';
    let s: str = "hello world";
    let b_true: bool = true;
    let b_false: bool = false;
    return i;
}

// Unary operators: negation, logical not
fun test_unary(x: int, flag: bool): int {
    let neg_x = -x;
    let neg_neg = --x;
    let flipped = !flag;
    if !flipped {
        return neg_x;
    }
    return neg_neg;
}

// Binary operators (arithmetic, comparison, logical, bitwise)
fun test_binops(a: int, b: int): int {
    let sum   = a + b;
    let diff  = a - b;
    let prod  = a * b;
    let quot  = a / b;
    let rem   = a % b;

    let eq    = a == b;
    let neq   = a != b;
    let lt    = a < b;
    let leq   = a <= b;
    let gt    = a > b;
    let geq   = a >= b;

    let land  = eq && neq;
    let lor   = lt || gt;

    let band  = a & b;
    let bor   = a | b;
    let bxor  = a ^ b;

    return sum + diff + prod + quot + rem;
}

// Tuples: construction, access, destructuring
fun test_tuples(): int {
    let pair = (10, 20);
    let fst = pair.0;
    let snd = pair.1;

    let (a, b) = (100, 200);

    let triple = (a, b, fst + snd);
    let (x, y, z) = triple;

    let nested = ((1, 2), (3, 4));
    let (inner_a, inner_b) = nested;

    return x + y + z;
}

// Method calls (inherent)
fun test_method_calls(): int {
    let origin = Point::new(0, 0);
    let moved = origin.translate(3, -4);
    let dist = moved.manhattan();
    return dist;
}

// Static calls with explicit type args
fun test_static_calls(): int {
    let w = Wrapper<int>::wrap(99);
    let val = w.unwrap();
    return val;
}

// Static calls with infer holes
fun test_static_infer(): int {
    let w = Wrapper<_>::wrap(42);
    return w.unwrap();
}

// Slice literals
fun test_slices(): int {
    let xs: [int] = { 10, 20, 30, 40, 50 };
    let first = xs[0];
    let last  = xs[4];
    return first + last;
}

// Indexing
fun test_index(): int {
    let arr: [int] = { 1, 2, 3 };
    let elem = arr[1];
    return elem;
}


// While loop
fun test_while_loop(): int {
    let mut counter = 0;
    while counter < 100 {
        counter += 1;
    }
    return counter;
}

// If / else chains
fun test_if_else(x: int): int {
    if x < 0 {
        return -1;
    } else {
        if x == 0 {
            return 0;
        } else {
            return 1;
        }
    }
}

// Nested blocks
fun test_blocks(): int {
    let a = 1;
    {
        let b = 2;
        {
            let c = 3;
            let _ = a + b + c;
        }
    }
    return a;
}

// Assignment and compound assignment (desugar)
fun test_assign(): int {
    let mut x = 0;
    x = 10;
    x += 5;
    x -= 2;
    x *= 3;
    x /= 2;
    x %= 7;
    return x;
}

// Pointer operations: address-of (@) and deref ($)
fun test_pointers(): int {
    let x = 42;
    let ptr = x@;
    let val = ptr$;
    return val;
}

// Chained pointer / field / deref
fun test_chained_deref(): int {
    let p = Point { .x: 7, .y: 8 };
    let pp = p@;
    let x_val = pp$.x;
    let y_val = pp$.y;
    return x_val + y_val;
}

// SizeOf directive
fun test_sizeof(): int {
    let s1 = @sizeof(int);
    let s2 = @sizeof(Point);
    let s3 = @sizeof(Pair<int, int>);
    return s1 + s2 + s3;
}

// Function calls (direct, with args, nested)
fun identity(x: int): int {
    return x;
}

fun add(a: int, b: int): int {
    return a + b;
}

fun test_calls(): int {
    let a = identity(5);
    let b = add(a, 10);
    let c = add(identity(1), identity(2));
    return b + c;
}

// Name resolution across modules
mod inner {
    fun secret(): int {
        return 777;
    }

    mod deeper {
        fun hidden(): int {
            return 888;
        }
    }
}

fun test_module_resolution(): int {
    let a = inner::secret();
    let b = inner::deeper::hidden();
    return a + b;
}

// Pattern: wildcard
fun test_wildcard(): int {
    let (_, b) = (1, 2);
    return b;
}

// Pattern: mut binding
fun test_mut_pattern(): int {
    let (mut x, y) = (0, 100);
    while x < y {
        x += 1;
    }
    return x;
}

// Complex expressions: deeply nested calls + binops
fun test_complex_expr(): int {
    let result = add(
        identity(add(1, 2)),
        add(identity(3), identity(add(4, 5)))
    );
    return result;
}

// String method calls
fun test_string_method(): void {
    "hello".println();
    let s: str = "world";
    s.println();
}

// Expression statements (calls for side effects)
fun side_effect(x: int): int {
    printf("effect: %d\n", x);
    return x;
}

fun test_expr_stmts(): int {
    side_effect(1);
    side_effect(2);
    side_effect(3);
    return 0;
}

// Return with and without value
fun test_return_void(): void {
    let x = 1;
    if x == 1 {
        return;
    }
    printf("unreachable\n");
}

fun test_return_expr(): int {
    return 1 + 2 + 3;
}

// Generic function definition
fun first_of<A, B>(a: A, b: B): A {
    return a;
}

fun make_pair<T>(x: T, y: T): (T, T) {
    return (x, y);
}

fun test_generic_calls(): int {
    let a = first_of(42, true);
    let (x, y) = make_pair(10, 20);
    return a + x + y;
}

// Linked-list-style pointer chasing
fun test_linked_list(): int {
    let node_b: Node<int> = Node { .data: 20, .next: 0 };
    let node_a: Node<int> = Node { .data: 10, .next: node_b@ };
    let data_a = node_a.data;
    let data_b = node_a.next$.data;
    return data_a + data_b;
}

// Lots of locals (stress local allocation)
fun test_many_locals(): int {
    let a = 1; let b = 2; let c = 3; let d = 4;
    let e = 5; let f = 6; let g = 7; let h = 8;
    let i = 9; let j = 10; let k = 11; let l = 12;
    let m = 13; let n = 14; let o = 15; let p = 16;
    return a+b+c+d+e+f+g+h+i+j+k+l+m+n+o+p;
}

// Tuple of structs
fun test_tuple_of_structs(): int {
    let pair = (Point { .x: 1, .y: 2 }, Point { .x: 3, .y: 4 });
    let (p1, p2) = pair;
    return p1.x + p1.y + p2.x + p2.y;
}

fun test_slice_of_tuples(): int {
    let data: [(int, int)] = { (1, 2), (3, 4), (5, 6) };
    let first = data[0];
    return first.0 + first.1;
}

fun main(): int {
    let r0  = test_literals();
    let r1  = test_unary(5, true);
    let r2  = test_binops(10, 3);
    let r3  = test_tuples();
    let r6  = test_method_calls();
    let r7  = test_static_calls();
    let r8  = test_static_infer();
    let r9  = test_slices();
    let r10 = test_index();
    let r13 = test_while_loop();
    let r14 = test_if_else(42);
    let r15 = test_blocks();
    let r16 = test_assign();
    let r17 = test_pointers();
    let r18 = test_chained_deref();
    let r19 = test_sizeof();
    let r20 = test_calls();
    let r21 = test_module_resolution();
    let r22 = test_wildcard();
    let r23 = test_mut_pattern();
    let r24 = test_complex_expr();
    test_string_method();
    let r25 = test_expr_stmts();
    test_return_void();
    let r26 = test_return_expr();
    let r27 = test_generic_calls();
    let r28 = test_linked_list();
    let r29 = test_many_locals();
    let r31 = test_tuple_of_structs();
    let r32 = test_slice_of_tuples();

    printf("All fuzz paths exercised.\n");
    printf("r0=%d r1=%d r2=%d r3=%d\n", r0, r1, r2, r3);
    printf("r6=%d r7=%d r8=%d r9=%d\n", r6, r7, r8, r9);
    printf("r10=%d r13=%d r14=%d\n", r10, r13, r14);
    printf("r15=%d r16=%d r17=%d r18=%d r19=%d\n", r15, r16, r17, r18, r19);
    printf("r20=%d r21=%d r22=%d r23=%d r24=%d\n", r20, r21, r22, r23, r24);
    printf("r25=%d r26=%d r27=%d r28=%d r29=%d\n", r25, r26, r27, r28, r29);
    printf("r31=%d r32=%d\n", r31, r32);

    return 0;
}
