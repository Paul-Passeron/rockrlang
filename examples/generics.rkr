fun foo<T>(x: T): T {
    return x;
}

enum A {
    Foo(str),
    Bar(int),
}

impl A {
    fun apply_foo(self): Self {
        match self {
            A::Foo(s) => {
                return A::Foo(foo(s));
            }
            A::Bar(i) => {
                return A::Bar(foo(i));
            }
        }
    }
}
