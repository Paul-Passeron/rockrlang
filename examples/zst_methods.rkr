struct Empty {}

impl Empty {
    fun hello(&self): void {
        "Hey !".println();
    }

    fun twice(&self): void {
        "Saying hello twice !".println();
    }

    fun consuming(self): void {
        "This is consuming".println();
    }
}

fun main(): int {
    let empty: Empty = Empty {};
    empty.hello();
    empty.twice();
    empty.consuming();
    
    return 0;
}
