//@ ignore: compiles cleanly now, the method-call-on-template bug looks fixed
// Kept as a repro. Either delete this file or promote it to examples/.
interface Foo {
    fun bar(&self): void;
}

struct X { x: int }

impl Foo for X {
    fun bar(&self): void {}
}

fun baz<T: Foo>(t: T): void {
    t.bar();
}

fun qux(x: X): void {
    baz(x);
}
