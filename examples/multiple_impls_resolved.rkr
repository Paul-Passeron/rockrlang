interface Foo {
    fun baz(&self): void;
}

interface Bar {
    fun baz(&self): void;
}


struct A {
    field: int;
}

impl Foo for A {
    fun baz(&self): void {}
}

impl Bar for A {
    fun baz(&self): void {}
}

fun main(): int {
    let a = A {.field: 5};
    // a.baz(); // This does not work as there are two candidates for baz method

    // This should be working
    Foo<>::baz(a);
    Bar<>::baz(a);
    return 0;
}
