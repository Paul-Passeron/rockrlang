struct Foo {
    x: int;
    y: str;
}

impl Foo {
    fun incr(&mut self): void {
        self.x = self.x  + 1;
    }
}

fun f(f: Foo): void {
    let mut f = f;
    let r = &f.x;  
    f.incr(); // Fine, the loan to r is dropped as r isn't used after
}

fun f2(f: Foo): void {
    let mut f = f;
    let r = &f;
    f.incr(); // Conflict here
    let u = r;
}


fun mv_fine(m: Moves): void {
    let x = m;
    let y = m; // Use after move 
}

fun mv_bad(m: Moves): void {
    let x = m;
    let y = &m; // Use after move
    match m { // Use after move
        m => { core::panic::panic("Panic !"); }
    }
}

fun in_loop(m: Moves): void {
    let x = m;
    for _ in 0..100 {
        let y = &x;
    }
}

fun in_loop2(m: Moves): void {
    let x = m;
    for _ in 0..100 {
        let y = x; // Maybe moved !
    }
}

struct Moves {}
