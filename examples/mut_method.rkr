struct Foo {
    x: int;
    y: str;
}

impl Foo {
    fun incr(&mut self): void {
        self.x = self.x  + 1;
    }
}

fun f(f: Foo): void {
    let mut x = f;
    let r: &_ = &x.x;  
    x.incr(); // Fine, the loan to r is dropped as r isn't used after
}

fun f(f: Foo): void {
    let mut x = f;
    let r: &_ = &x.x;
    x.incr(); // Not fine, the loan to r is still active !
    let u = r;
}


fun mv_fine(m: Moves): void {
    let x = m;
    let y = m;
}

fun mv_bad(m: Moves): void {
    let x = m;
    let y = &m; // No error here when there should be !
    match m { 
        m => { core::panic::panic("Panic !"); }
    }
}

fun in_loop(m: Moves): void {
    let x = m;
    for _ in 0..100 {
        let y = &x;
    }
}

fun in_loop2(m: Moves): void {
    let x = m;
    for _ in 0..100 {
        let y = x;
    }
}

struct Moves {}
