enum Foo {
    Bar { x: Bar; y: str }
}

struct Bar {
    x: int;
    y: str;
}

fun qux(foo: Foo): void {
    match foo {
        Foo::Bar { x: Bar {x, y}, y: z } => {
            let a: int = x;
            let b: str = y;
            let c: str = z;
        }
    }
}

fun quux(foo: &Foo): void {
    match foo {
        Foo::Bar { x: Bar {x, y}, y: z } => {
            let a: &int = x;
            let b: &str = y;
            let c: &str = z;
        }
    }
}
