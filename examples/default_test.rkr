@include core

struct Wrapper<T: Default> {
    value: T;
}

impl <T: Default> Default for Wrapper<T> {
    fun default(): Self {
        return Self { .value: T::default() };
    }
}

impl Default for int {
    fun default(): int {
        return 0;
    }
}

fun main(): int {
    let x: Wrapper<int> = Wrapper<int>::default();
    return 0;
}
