thir fun zelf_non_receiver::main(): i32 {
    let f1: zelf_non_receiver::Foo = zelf_non_receiver::Foo { x: 123, y: 456 };
    let f2: zelf_non_receiver::Foo = zelf_non_receiver::Foo { x: 321, y: 654 };
    let f3: zelf_non_receiver::Foo = <zelf_non_receiver::Foo>::<zelf_non_receiver::Foo as zelf_non_receiver::Addable>::add(&f1, &f2);
    let f4: zelf_non_receiver::Foo = <zelf_non_receiver::Foo>::T0::double::<zelf_non_receiver::Foo>(&f1);
    <zelf_non_receiver::Foo>::zelf_non_receiver::Foo::dump(&f1);
    zelf_non_receiver::nl();
    <zelf_non_receiver::Foo>::zelf_non_receiver::Foo::dump(&f2);
    zelf_non_receiver::nl();
    <zelf_non_receiver::Foo>::zelf_non_receiver::Foo::dump(&f3);
    zelf_non_receiver::nl();
    <zelf_non_receiver::Foo>::zelf_non_receiver::Foo::dump(&f4);
    zelf_non_receiver::nl();
    let f5: zelf_non_receiver::Foo = <zelf_non_receiver::Foo>::zelf_non_receiver::Foo::comsuming_add(f1, f2);
    <zelf_non_receiver::Foo>::zelf_non_receiver::Foo::dump(&f5);
    zelf_non_receiver::nl();
    return 0;
}

