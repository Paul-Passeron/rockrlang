examples/match_structlit.rkr:11:1
thir fun main(): i32 {
    let it: LooksLikeAStruct = getIt();
    match it {
        LooksLikeAStruct::#0 { x: x, y: y } => 's1: {
            io::printf(c"Got A, x = %d and y = %d\n\0", x, y);
        }
        LooksLikeAStruct::#1 { z: z, foo: foo } => 's2: {
            io::printf(c"Got B, z = %d and foo = %d\n\0", z, foo);
        }
        LooksLikeAStruct::#2 => 's3: {
            io::printf(c"None\n\0");
        }
    }
    return 0;
}

