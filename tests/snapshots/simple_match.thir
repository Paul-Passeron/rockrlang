}

examples/simple_match.rkr:7:1
thir fun simple_match::foo(): i32 {
    match simple_match::some_opt() {
        core::opt::opt::<i32>::#1(x) => 's0: {
            return x;
        }
        core::opt::opt::<i32>::#0 => 's1: {
            return 0;
        }
    }
}

