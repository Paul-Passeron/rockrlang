examples/loans.rkr:39:1
thir fun borrow_in_loop(n: i32): i32 {
    let x: i32 = 5;
    let mut i: i32 = 0;
    let mut acc: i32 = 0;
    's1: while (i < n) {
        let r: &i32 = &x;
        acc = (acc + (*r));
        i = (i + 1);
    }
    return acc;
}

