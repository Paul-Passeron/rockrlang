thir fun io::str::print(&self): void {
    io::printf(c"%.*s\0", (*self).len, (*self).data);
}

core/panic.rkr:1:1
thir fun panic::panic(message: io::str): never {
    io::printf(c"Oh no, a panic has occurred!\nmsg: \'\0");
    <io::str>::io::str::print(&message);
    io::printf(c"\'\n\nAborting with code 1...\n\0");
    sys::exit(1);
    drop obligations:
        drop message;
}

